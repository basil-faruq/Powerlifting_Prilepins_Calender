# Secrets and local config
.env
.env.local
.claude.json
.claude/settings.local.json

# The authored template is the athlete's own data — never committed.
# CONTEXT.md §4 documents everything the golden test needs to know about it.
data/*.xlsx
!data/.gitkeep

# ADR plugin tooling: installed alongside the project, not part of it. The files
# stay on disk so the plugin keeps working; only `docs/adr/` (the ADRs it writes)
# and `.claude/specs/` belong in version control.
.claude/adr.local.md
.claude/agents/adr-*.md
.claude/commands/adr-*.md
.claude/schemas/adr-export.schema.json
.claude/site/
.claude/skills/adr-*/
.claude/templates/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / frontend (spec 16)
node_modules/
dist/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
