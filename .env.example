# Copy to .env and fill in what you need. Every variable here has a safe default
# in backend/planner_core/config.py; a blank value means "unset".
#
# Complex values (lists) are parsed as JSON, so they must use double quotes.

# --- Infrastructure ---------------------------------------------------------

# Matches the Postgres service in docker-compose.yml (make infra).
DATABASE_URL=

# Temporal dev server started by make infra.
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=strength-planner
# `temporal server start-dev` creates this one namespace and no other.
TEMPORAL_NAMESPACE=default

# The athlete's timezone. Dates are ISO YYYY-MM-DD and weekdays 0=Monday.
TIMEZONE=Europe/Berlin

# --- LLM provider -----------------------------------------------------------

# ollama (default, local) or anthropic (demos only, costs money).
# Embeddings stay local in both modes.
LLM_PROVIDER=ollama

# Ollama runs natively on the host, never in Compose (it needs the GPU).
# Pull these before anything that touches the agent:
#   ollama pull qwen2.5:14b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_ROUTER_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Sizes note_chunk.embedding. Must match the embedding model's output dimension.
EMBED_DIM=768

# Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5

# --- Tracing (Langfuse, spec 14) --------------------------------------------

# Leave both keys blank to disable tracing; the app then runs identically
# and logs "Tracing disabled (no Langfuse keys)".
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional. Used only to build the trace_url returned by the API.
LANGFUSE_PROJECT_ID=

# --- API --------------------------------------------------------------------

# JSON list. The Vite dev server (make web) runs on this origin.
CORS_ORIGINS=
