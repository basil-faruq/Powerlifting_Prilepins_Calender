# Copy to .env and edit. Every value here is a safe local default, so the app
# starts with no .env at all. Never commit .env.

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://planner:planner@localhost:5432/planner
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=strength-planner
TIMEZONE=Europe/Berlin

# --- LLM provider ----------------------------------------------------------
# ollama (default) or anthropic. Embeddings stay local in either mode.
LLM_PROVIDER=ollama

# Ollama runs on the host, not in Compose. Pull the models first:
#   ollama pull qwen2.5:14b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_ROUTER_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Must match the embedding model's output dimension.
EMBED_DIM=768

# --- Anthropic (demos only) -----------------------------------------------
# Required only when LLM_PROVIDER=anthropic; startup fails without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5

# --- Langfuse tracing (spec 14) -------------------------------------------
# Tracing is disabled while these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=

# --- API -------------------------------------------------------------------
# A list, so it must be JSON. A bare URL will not parse.
CORS_ORIGINS=["http://localhost:5173"]
