# Copy to .env and fill in what you need. Every variable here has a safe default
# in backend/planner_core/config.py; a blank value means "unset".
#
# Complex values (lists) are parsed as JSON, so they must use double quotes.
#
# WHERE THIS FILE IS ACTUALLY READ. `make up` passes it to the containers
# explicitly, so everything below reaches them -- except four values that
# docker-compose.yml overrides, because localhost inside a container is the
# container:
#
#   DATABASE_URL     postgresql+psycopg://planner:planner@postgres:5432/planner
#   TEMPORAL_ADDRESS temporal:7233
#   OLLAMA_BASE_URL  http://host.docker.internal:11434
#   CORS_ORIGINS     [] -- Caddy serves the app and the API on one origin
#
# The HOST targets (make api, make worker) do NOT read this file. Settings load
# `.env` relative to the working directory and those targets `cd backend` first,
# so they see the defaults in planner_core/config.py unless you export the
# variable yourself or put a second .env in backend/. Keeping it that way is
# deliberate: it means tracing, which sends prompts and note text to Langfuse,
# cannot switch itself on for host development just because a key is in this
# file. See docs/adr/0024-local-deployment.md.

# --- Infrastructure ---------------------------------------------------------

# Matches the Postgres service in docker-compose.yml (make infra).
DATABASE_URL=

# Temporal dev server started by make infra.
TEMPORAL_ADDRESS=
TEMPORAL_TASK_QUEUE=strength-planner
# `temporal server start-dev` creates this one namespace and no other.
TEMPORAL_NAMESPACE=default

# The athlete's timezone. Dates are ISO YYYY-MM-DD and weekdays 0=Monday.
TIMEZONE=Europe/Berlin

# --- LLM provider -----------------------------------------------------------

# ollama (default, local) or anthropic (demos only, costs money).
# Embeddings stay local in both modes.
LLM_PROVIDER=ollama

# Ollama runs natively on the host, never in Compose (it needs the GPU).
# Pull these before anything that touches the agent:
#   ollama pull qwen2.5:14b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_ROUTER_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Sizes note_chunk.embedding. Must match the embedding model's output dimension.
EMBED_DIM=768

# Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5

# --- Tracing (Langfuse, spec 14) --------------------------------------------

# Leave both keys blank to disable tracing; the app then runs identically
# and logs "Tracing disabled (no Langfuse keys)".
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional. Used only to build the trace_url returned by the API.
LANGFUSE_PROJECT_ID=

# --- API --------------------------------------------------------------------

# JSON list. The Vite dev server (make web) runs on this origin.
#
# `make up` sets this to [] instead: Caddy serves the app and proxies /api/* on
# one origin, so the browser never makes a cross-origin request.
CORS_ORIGINS=

# --- Host ports for `make up` -----------------------------------------------

# Only needed to run a second stack beside the first, or when something else
# already holds one of these:
#
#   COMPOSE_PROJECT_NAME=scratch WEB_PORT=8081 TEMPORAL_UI_PORT=18233 make up
#
# COMPOSE_PROJECT_NAME rather than `-p`, because the Make targets inherit the
# environment variable and cannot see the flag -- `make seed DOCKER=1` with a
# `-p` stack running would otherwise seed the DEFAULT stack's database.
#
# WEB_PORT=8080           the app, and /api/* behind it
# POSTGRES_PORT=5432      so host tools can reach the containerised database
# TEMPORAL_PORT=7233      gRPC
# TEMPORAL_UI_PORT=8233   the Temporal web UI
#
# The api's own 8000 is deliberately never published: Caddy is the way in.
